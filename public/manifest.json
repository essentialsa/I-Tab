{
  "manifest_version": 3,
  "name": "Tabbit AI 智能标签页整理",
  "version": "1.0.0",
  "description": "基于大模型语义分析的 Chrome 标签页智能整理插件，支持原生彩色折叠分组与 Tabbit 风格侧边栏画廊预览",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI 整理当前窗口标签页 (Cmd+Shift+G)",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "organize-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "一键执行 AI 标签页语义智能整理"
    }
  }
}
